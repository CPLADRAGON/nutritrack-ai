{
  // Cloudflare Workers project configuration.
  // The Worker serves the built SPA from ./dist and handles /api/auth/*.
  "name": "nutritrack-ai",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sign-in and the OAuth callback are top-level navigations. Without this,
    // the SPA fallback would serve index.html instead of reaching the Worker.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      // Replace with the ID of your KV namespace (Storage & Databases -> KV).
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
